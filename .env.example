APP_NAME=wpi-hub
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL — match the legacy schema charset (utf8mb3).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hub_dev
DB_USERNAME=hub
DB_PASSWORD=
DB_CHARSET=utf8mb3
DB_COLLATION=utf8mb3_general_ci

# API-only: no DB-backed session/cache/queue tables.
SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_CONNECTION=sync
CACHE_STORE=file

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Mailgun SMTP (smtp.mailgun.org:587 STARTTLS, or :465 with MAIL_SCHEME=smtps).
# MAIL_MAILER=log writes mail to storage/logs instead of sending it.
MAIL_MAILER=log
MAIL_SCHEME=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@windingpath.club"
MAIL_FROM_NAME="${APP_NAME}"

# --- wpi-hub ----------------------------------------------------------------

# API version (Node derived this from package.json major => v1).
API_VERSION=v1
WPI_VERSION=1.0.5

# Cognito / JWT (web-token; later Keycloak). JWKS lives in config/cognito.php.
COGNITO_TOKEN_ISS="https://cognito-idp.us-east-1.amazonaws.com/us-east-1_EW8ym2TET"
COGNITO_TOKEN_KID=""

# Internal-only endpoints: shared-secret guard (replaces dual-port trust).
INTERNAL_SECRET=

# Audit service ("bypass" disables; also disabled when APP_ENV=testing).
AUDIT_HOST=bypass

# CORS allowed origins (comma-separated), ported from clients.json.
CORS_ALLOWED_ORIGINS="https://membersbeta.windingpath.club,http://192.168.1.26:4201"
